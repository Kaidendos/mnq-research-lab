//@version=6
// Mean-Reversion v1.1 (NQ/MNQ) - fade a stretch back to the BB mean on the reclaim,
// ranging regime only, trend-aligned, RTH only. Mirror of meanrev.js.
//   BASELINE -> set "ATR stop mult" = 1.0
//   VARIANT  -> set "ATR stop mult" = 0.5
// Run on MNQ1! 5-min chart. Debug table (top-right) + buy/sell markers help
// confirm signals fire. Remove the DEBUG block once it works.
strategy("Mean-Rev v1.1 - ATR-stop variant", overlay=true, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false, initial_capital=50000, default_qty_type=strategy.fixed, default_qty_value=5)

// ---------------- Inputs ----------------
contracts   = input.int(5,      "Contracts (MNQ) try 1/2/3/5", minval=1, group="Sizing")
atrStopMult = input.float(1.0,  "ATR stop mult 1.0=base 0.5=variant", step=0.25)
bbLen       = input.int(20,     "BB length")
bbMult      = input.float(2.0,  "BB mult")
rsiLen      = input.int(2,      "RSI length")
rsiOS       = input.int(10,     "RSI oversold")
rsiOB       = input.int(90,     "RSI overbought")
adxLen      = input.int(14,     "ADX/DMI length")
adxMax      = input.float(25.0, "ADX max ranging filter")
emaLen      = input.int(200,    "EMA trend length")
atrLen      = input.int(14,     "ATR length")
confirmBars = input.int(3,      "Confirm bars reclaim window")
tz          = "America/New_York"

// ---------------- Indicators ----------------
basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev
rsiV  = ta.rsi(close, rsiLen)
emaV  = ta.ema(close, emaLen)
atrV  = ta.atr(atrLen)
[diPlus, diMinus, adxV] = ta.dmi(adxLen, adxLen)

// ---------------- Session / time gates (direct ET math, mirrors meanrev.js) ----------------
etHour    = hour(time, tz)
etMin     = minute(time, tz)
etMins    = etHour * 60 + etMin
dow       = dayofweek(time, tz)
isWeekday = dow != dayofweek.saturday and dow != dayofweek.sunday
inSession = isWeekday and etMins >= 570 and etMins < 960
isEOD     = isWeekday and etHour == 15 and etMin == 55
ranging   = adxV < adxMax
canTrade  = inSession and not isEOD and ranging

// ---------------- Setups (entry = close of trigger bar) ----------------
stretchLong   = close <= lower and rsiV <= rsiOS
barsSinceLong = ta.barssince(stretchLong)
reclaimLong   = close > lower and close[1] <= lower[1]
longSetup     = canTrade and reclaimLong and barsSinceLong <= confirmBars and close > emaV

stretchShort   = close >= upper and rsiV >= rsiOB
barsSinceShort = ta.barssince(stretchShort)
reclaimShort   = close < upper and close[1] >= upper[1]
shortSetup     = canTrade and reclaimShort and barsSinceShort <= confirmBars and close < emaV

// ---------------- Orders ----------------
var float stopPrice  = na
var float limitPrice = na

if longSetup and strategy.position_size == 0
    strategy.entry("L", strategy.long, qty=contracts)
    stopPrice  := close - atrStopMult * atrV
    limitPrice := basis

if shortSetup and strategy.position_size == 0
    strategy.entry("S", strategy.short, qty=contracts)
    stopPrice  := close + atrStopMult * atrV
    limitPrice := basis

strategy.exit("L-exit", from_entry="L", stop=stopPrice, limit=limitPrice)
strategy.exit("S-exit", from_entry="S", stop=stopPrice, limit=limitPrice)

if isEOD
    strategy.close_all(comment="EOD")

// ---------------- DEBUG counts (one statement per line; remove once it works) ----------------
var int cBars   = 0
var int cSess   = 0
var int cRange  = 0
var int cEmaOK  = 0
var int cStretL = 0
var int cReclL  = 0
var int cLong   = 0
var int cShort  = 0
cBars   += 1
cSess   += inSession ? 1 : 0
cRange  += ranging ? 1 : 0
cEmaOK  += na(emaV) ? 0 : 1
cStretL += stretchLong ? 1 : 0
cReclL  += reclaimLong ? 1 : 0
cLong   += longSetup ? 1 : 0
cShort  += shortSetup ? 1 : 0

if barstate.islast
    var table t = table.new(position.top_right, 2, 9, border_width=1)
    table.cell(t, 0, 0, "DEBUG", bgcolor=color.navy, text_color=color.white)
    table.cell(t, 1, 0, "count", bgcolor=color.navy, text_color=color.white)
    table.cell(t, 0, 1, "bars total")
    table.cell(t, 1, 1, str.tostring(cBars))
    table.cell(t, 0, 2, "inSession RTH")
    table.cell(t, 1, 2, str.tostring(cSess))
    table.cell(t, 0, 3, "ranging adx<25")
    table.cell(t, 1, 3, str.tostring(cRange))
    table.cell(t, 0, 4, "ema200 ready")
    table.cell(t, 1, 4, str.tostring(cEmaOK))
    table.cell(t, 0, 5, "stretchLong")
    table.cell(t, 1, 5, str.tostring(cStretL))
    table.cell(t, 0, 6, "reclaimLong")
    table.cell(t, 1, 6, str.tostring(cReclL))
    table.cell(t, 0, 7, "longSetup")
    table.cell(t, 1, 7, str.tostring(cLong))
    table.cell(t, 0, 8, "shortSetup")
    table.cell(t, 1, 8, str.tostring(cShort))

// ---------------- Plots + signal markers ----------------
plot(basis, "BB basis", color.new(color.orange, 0))
plot(upper, "BB upper", color.new(color.gray, 50))
plot(lower, "BB lower", color.new(color.gray, 50))
plot(emaV,  "EMA200",   color.new(color.blue, 0))
plotshape(longSetup,  "BUY",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(shortSetup, "SELL", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.small)
bgcolor(inSession ? color.new(color.green, 92) : na, title="RTH shade")
