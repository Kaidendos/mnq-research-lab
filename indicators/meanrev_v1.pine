//@version=5
// =============================================================
//  NQ Mean-Reversion Strategy — v1  (NEW archetype)
//  WHY THIS EXISTS:
//    v3/v5 are TREND-FOLLOWING (35-42% win, lumpy equity, deep chop
//    drawdowns). That shape structurally BUSTS TopStep's $2,000
//    *trailing* Max-Loss-Limit, which rewards a SMOOTH equity curve.
//    No parameter tweak fixed it — it's an archetype-vs-account
//    mismatch. So v1 is the opposite archetype: FADE extremes back
//    to the mean. Goal = high win rate (target 60%+), small quick
//    wins, tight risk, shallow drawdown => smoother equity.
//
//  CORE (Connors-style, adapted intraday for TopStep):
//    - Fade a Bollinger-band stretch + RSI(2) exhaustion
//    - ONLY in a RANGING regime (ADX BELOW a ceiling — the inverse
//      of the trend filter; we do NOT fade strong trends)
//    - Trade dips/rips WITH the higher trend (long dips above EMA200,
//      short rips below) so we don't catch falling knives
//    - Target = the mean (BB basis). Stop = ATR-sized. Time-stop so a
//      failed fade can't ride a breakout into a big loss.
//    - Circuit breakers for a smooth curve: max trades/day, and stop
//      for the day after N consecutive losses.
//    - RTH session, daily-loss lockout, EOD flatten (kept from v5).
//
//  v3/v5 remain the trend-following baseline — do NOT delete them.
//  Validation = TradingView Strategy Tester (ground truth). The Node
//  backtester is NOT trusted until reconciled trade-for-trade.
//  NQ ($20/pt) or MNQ ($2/pt) — switch the symbol.
// =============================================================
strategy("NQ Mean-Reversion - v1", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=50000,
     commission_type=strategy.commission.cash_per_contract, commission_value=2.0,
     calc_on_every_tick=false, max_labels_count=500, max_lines_count=500)

// ===== Inputs =====
// Bollinger: standard MR length 20/2.0 (wider/slower than v5's 12 so a
// "touch" of the band is a meaningful stretch, not 5-min noise).
bbLen   = input.int(20,  "Bollinger Length",  group="Indicators")
bbMult  = input.float(2.0,"Bollinger StdDev", group="Indicators")
// RSI(2) is the Connors exhaustion gauge — it whips to extremes fast,
// which is what we want for a fade trigger.
rsiLen  = input.int(2,   "RSI Length",        group="Indicators")
rsiOS   = input.int(10,  "RSI oversold (<= long)",  group="Indicators", minval=1, maxval=30)
rsiOB   = input.int(90,  "RSI overbought (>= short)",group="Indicators", minval=70, maxval=99)

// ===== Entry timing (v1.1) =====
// v1 faded MID-STRETCH (bought while price was still beyond the band =
// catching the knife). That forces a big adverse excursion → wide stop →
// big losses → deep drawdown. v1.1 default: enter on the RECLAIM (price
// closes back INSIDE the band after a recent stretch). The fall has
// already paused, so the trade works sooner and a tighter stop survives.
useConfirm  = input.bool(true, "Enter on RECLAIM (confirmation), not raw touch", group="Entry")
confirmBars = input.int(3, "Reclaim must come within N bars of the stretch", group="Entry", minval=1, maxval=6)

// ===== Regime (the INVERSE of v5) =====
// Mean reversion works in CHOP, dies in trends. So ADX must be BELOW a
// ceiling. (v5 needed ADX ABOVE a floor — opposite edge.)
adxLen  = input.int(14, "ADX Length",                group="Regime")
adxMax  = input.float(25, "Max ADX (range filter)",  group="Regime")
useTrend= input.bool(true, "Trade with higher trend (EMA)", group="Regime")
trendLen= input.int(200, "Trend EMA length",          group="Regime")

// ===== Risk =====
atrLen   = input.int(14, "ATR Length",                group="Risk")
atrStop  = input.float(1.0, "Stop = x ATR",           group="Risk")
useMeanTgt = input.bool(true, "Target = BB basis (the mean)", group="Risk")
tgtAtr   = input.float(1.0, "…else Target = x ATR",   group="Risk")
maxHold  = input.int(12, "Time-stop: max bars in trade", group="Risk", minval=2)
dayLoss  = input.float(1000, "Daily Loss Limit ($)",  group="Risk")

// ===== Circuit breakers (smooth-equity controls) =====
maxTrades  = input.int(4, "Max trades per day",        group="Circuit breakers", minval=1)
maxConsec  = input.int(2, "Stop day after N consec losses", group="Circuit breakers", minval=1)

// ===== Session / direction =====
useSession = input.bool(true, "RTH session filter",      group="Filters")
sess       = input.session("0930-1600", "Session (ET)",  group="Filters")
flattenEOD = input.bool(true, "Flatten at session end",  group="Filters")
useLong    = input.bool(true, "Allow Longs (fade dips)", group="Direction")
useShort   = input.bool(true, "Allow Shorts (fade rips)",group="Direction")

// Free-plan window backtester (no Premium date picker needed):
useDateFilter = input.bool(false, "Limit to date window below", group="Backtest Window")
startDate     = input.time(timestamp("2026-01-01T00:00"), "Window start", group="Backtest Window")
endDate       = input.time(timestamp("2026-01-31T23:59"), "Window end",   group="Backtest Window")

// ===== Indicators =====
basis   = ta.sma(close, bbLen)
dev     = bbMult * ta.stdev(close, bbLen)
upperBB = basis + dev
lowerBB = basis - dev
rsi     = ta.rsi(close, rsiLen)
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
trendEMA = ta.ema(close, trendLen)
atr     = ta.atr(atrLen)

// ===== Filters / regime =====
inSession = useSession ? not na(time(timeframe.period, sess, "America/New_York")) : true
ranging   = adx < adxMax                                   // INVERSE of v5
upBias    = not useTrend or close > trendEMA               // long dips in uptrend
dnBias    = not useTrend or close < trendEMA               // short rips in downtrend
inWindow  = not useDateFilter or (time >= startDate and time <= endDate)

// Daily-loss lockout
newDay = ta.change(time("D")) != 0
var float dayStartEq = na
if newDay
    dayStartEq := strategy.equity
dayPnL  = na(dayStartEq) ? 0.0 : strategy.equity - dayStartEq
lockout = dayPnL <= -dayLoss

// ===== Circuit breakers: per-day trade count + consecutive losses =====
var int tradesToday = 0
var int consecLoss  = 0
var int lastClosed  = 0
if newDay
    tradesToday := 0
    consecLoss  := 0
// Tally a freshly closed trade: was it a loss?
if strategy.closedtrades > lastClosed
    won = strategy.closedtrades.profit(strategy.closedtrades - 1) > 0
    consecLoss := won ? 0 : consecLoss + 1
    lastClosed := strategy.closedtrades
breakersOK = tradesToday < maxTrades and consecLoss < maxConsec

// ===== Signal logic: FADE the stretch =====
// Raw stretch (v1 behavior): price beyond the band + RSI exhausted.
stretchLong  = close <= lowerBB and rsi <= rsiOS
stretchShort = close >= upperBB and rsi >= rsiOB
// Confirmation (v1.1 default): after a recent stretch, price RECLAIMS the
// band (closes back across it). Entering on the reclaim — not mid-stretch
// — means the adverse move has already paused, so a tighter stop survives.
reclaimLong  = ta.crossover(close, lowerBB)  and ta.barssince(stretchLong)  <= confirmBars
reclaimShort = ta.crossunder(close, upperBB) and ta.barssince(stretchShort) <= confirmBars
trigLong  = useConfirm ? reclaimLong  : stretchLong
trigShort = useConfirm ? reclaimShort : stretchShort

longCond  = useLong  and trigLong  and ranging and upBias and inSession and not lockout and breakersOK and inWindow
shortCond = useShort and trigShort and ranging and dnBias and inSession and not lockout and breakersOK and inWindow

sig  = longCond ? "BUY" : shortCond ? "SELL" : lockout ? "LOCKED" : not breakersOK ? "DONE-DAY" : not inSession ? "CLOSED" : "WAIT"
bias = close > basis ? "ABOVE MEAN" : close < basis ? "BELOW MEAN" : "AT MEAN"

// ===== Orders =====
if longCond
    strategy.entry("Long", strategy.long)
if shortCond
    strategy.entry("Short", strategy.short)

inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0

// Count a trade the bar it opens (for the per-day cap)
opened = strategy.position_size != 0 and strategy.position_size[1] == 0
if opened
    tradesToday += 1

// Stops/targets. Stop is ATR-sized off the fill; target is the mean
// (or an ATR multiple if the mean target is disabled).
entryPx   = strategy.position_avg_price
stopDist  = atrStop * atr

if inLong
    strategy.exit("Exit Long", from_entry="Long",
         stop = entryPx - stopDist, limit = useMeanTgt ? basis : entryPx + tgtAtr * atr)
if inShort
    strategy.exit("Exit Short", from_entry="Short",
         stop = entryPx + stopDist, limit = useMeanTgt ? basis : entryPx - tgtAtr * atr)

// Time-stop: a fade that hasn't reverted in maxHold bars is wrong —
// cut it before it becomes a trend loss.
var int barsInTrade = 0
barsInTrade := strategy.position_size != 0 ? barsInTrade + 1 : 0
if strategy.position_size != 0 and barsInTrade >= maxHold
    strategy.close_all("Time stop")

// Flatten at end of RTH session
sessionEnding = inSession[1] and not inSession
if flattenEOD and sessionEnding and strategy.position_size != 0
    strategy.close_all("EOD")
if lockout and strategy.position_size != 0
    strategy.close_all("Daily stop")

// ===== CLEAR entry -> exit visuals =====
longOpened  = strategy.position_size > 0 and strategy.position_size[1] <= 0
shortOpened = strategy.position_size < 0 and strategy.position_size[1] >= 0
justFlat    = strategy.position_size == 0 and strategy.position_size[1] != 0

if longOpened
    label.new(bar_index, low,  "FADE+", style=label.style_label_up,   color=color.new(color.green,0), textcolor=color.white, size=size.small)
if shortOpened
    label.new(bar_index, high, "FADE-", style=label.style_label_down, color=color.new(color.red,0),   textcolor=color.white, size=size.small)

if justFlat and strategy.closedtrades > 0
    i     = strategy.closedtrades - 1
    ePx   = strategy.closedtrades.entry_price(i)
    xPx   = strategy.closedtrades.exit_price(i)
    eBar  = strategy.closedtrades.entry_bar_index(i)
    xBar  = strategy.closedtrades.exit_bar_index(i)
    won   = strategy.closedtrades.profit(i) > 0
    col   = won ? color.new(color.green, 0) : color.new(color.red, 0)
    line.new(eBar, ePx, xBar, xPx, color=col, width=2)
    label.new(xBar, xPx, won ? "WIN" : "LOSS",
         style = won ? label.style_label_down : label.style_label_up,
         color=col, textcolor=color.white, size=size.tiny)

// ===== Bands + trend =====
plot(basis, "BB Basis (mean/target)", color=color.new(color.gray, 0))
pu = plot(upperBB, "BB Upper", color=color.new(color.blue, 50))
pl = plot(lowerBB, "BB Lower", color=color.new(color.blue, 50))
fill(pu, pl, color=color.new(color.blue, 95))
plot(useTrend ? trendEMA : na, "Trend EMA", color=color.new(color.orange, 0), linewidth=2)

// ===== UI panel =====
var table t = table.new(position.top_right, 2, 11, border_width=1, frame_color=color.gray, frame_width=1)
if barstate.islast
    sigColor = sig == "BUY" ? color.green : sig == "SELL" ? color.red : color.new(color.gray, 30)
    g = color.new(color.gray, 40)
    table.cell(t, 0, 0, "Mean-Rev", bgcolor=color.black, text_color=color.white)
    table.cell(t, 1, 0, "v1.1",     bgcolor=color.black, text_color=color.white)
    table.cell(t, 0, 1, "Signal", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 1, sig,      text_color=color.white, bgcolor=sigColor)
    table.cell(t, 0, 2, "Pos vs mean", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 2, bias,     text_color=color.white, bgcolor=g)
    table.cell(t, 0, 3, "Trend",  text_color=color.white, bgcolor=g)
    table.cell(t, 1, 3, close > trendEMA ? "UP" : "DOWN", text_color=color.white, bgcolor=g)
    table.cell(t, 0, 4, "RSI(2)", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 4, str.tostring(rsi, "#.0"), text_color=color.white, bgcolor=g)
    table.cell(t, 0, 5, "ADX",    text_color=color.white, bgcolor=g)
    table.cell(t, 1, 5, str.tostring(adx, "#.0") + (ranging ? " range" : " TREND"), text_color=color.white, bgcolor=ranging ? g : color.new(color.orange, 20))
    table.cell(t, 0, 6, "ATR",    text_color=color.white, bgcolor=g)
    table.cell(t, 1, 6, str.tostring(atr, "#.0") + " pt", text_color=color.white, bgcolor=g)
    table.cell(t, 0, 7, "Session",text_color=color.white, bgcolor=g)
    table.cell(t, 1, 7, inSession ? "OPEN" : "closed", text_color=color.white, bgcolor=g)
    table.cell(t, 0, 8, "Day P/L",text_color=color.white, bgcolor=g)
    table.cell(t, 1, 8, "$" + str.tostring(dayPnL, "#"), text_color=color.white, bgcolor=lockout ? color.red : g)
    table.cell(t, 0, 9, "Trades today",text_color=color.white, bgcolor=g)
    table.cell(t, 1, 9, str.tostring(tradesToday) + " / " + str.tostring(maxTrades), text_color=color.white, bgcolor=g)
    table.cell(t, 0, 10, "Loss streak",text_color=color.white, bgcolor=g)
    table.cell(t, 1, 10, str.tostring(consecLoss) + " / " + str.tostring(maxConsec), text_color=color.white, bgcolor=consecLoss >= maxConsec ? color.red : g)

// ===== Alerts =====
alertcondition(longCond,  "FADE LONG",  "Mean-Rev v1 BUY (fade oversold)")
alertcondition(shortCond, "FADE SHORT", "Mean-Rev v1 SELL (fade overbought)")
