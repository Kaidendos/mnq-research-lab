//@version=5
// =============================================================
//  NQ Opening-Range Breakout (ORB) — v4   (let winners RUN: trailing-stop exit)
//
//  THE PROBLEM v4 FIXES (found by testing v1-v3):
//    - 40% win rate x fixed 1.5R target = ~0R expectancy (breakeven, PF ~1.2).
//    - ORB's real edge is the occasional BIG trend day, but a fixed 1.5R
//      target CAPS that winner and books it early — while every loss is a
//      full opening-range width. Small capped wins + full losses = stuck.
//    - Midpoint stop (v3 test) made it WORSE (PF 0.78): tighter stop just
//      gets chopped out. Wider opposite-side stop is better. Reverted.
//
//  THE FIX: a 40%-win breakout system only works if winners RUN. So v4
//  replaces the fixed target with a TRAILING STOP: keep the wide initial
//  stop, and once the trade is +1R in profit, trail the stop behind price
//  so a strong open can run to 3R/5R and only exits when price turns.
//  This fattens the right tail that pays for the frequent small losses.
//
//  Also: daily profit/loss lockouts are now OPT-IN (default OFF). They are
//  absolute-$ rules sized to ONE contract size, so they distort NQ-vs-MNQ
//  comparisons. Keep OFF for backtests/validation; turn ON only for live
//  trading on the exact contract size you'll use.
//
//  >>> Validate on NQ1! (5.5mo history), size live on MNQ (divide $ by 10).
//      MUST run on a 1/3/5-min chart. Strategy Tester = ground truth. <<<
// =============================================================
strategy("NQ Opening-Range Breakout - v4", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=50000,
     commission_type=strategy.commission.cash_per_contract, commission_value=2.0,
     calc_on_every_tick=false, max_labels_count=500, max_lines_count=500)

// ===== Opening range =====
orMinutes = input.int(15, "Opening-range length (min)", group="Opening Range", minval=1,
     tooltip="15 = classic NQ default (9:30-9:45 ET). Try 5 (aggressive) or 30 (lets the open settle).")
openHHMM  = input.int(930, "Session open (HHMM ET)", group="Opening Range")
bufTicks  = input.int(2, "Breakout buffer (ticks past the range)", group="Opening Range", minval=0)

// ===== Entry window =====
entryEndHHMM = input.int(1030, "Stop taking new breaks after (HHMM ET)", group="Entry Window")

// ===== Trend filter =====
useTrendFilter = input.bool(true, "Only break WITH session VWAP", group="Trend Filter",
     tooltip="ON = long only above the opening VWAP, short only below. Confirmed better in A/B testing.")

// ===== Range quality filter =====
useRangeFilter = input.bool(false, "Skip days with a junk-sized OR", group="Range Filter")
minRangePts = input.float(8,  "Min OR width (pts)", group="Range Filter")
maxRangePts = input.float(70, "Max OR width (pts)", group="Range Filter")

// ===== Exit style (NEW in v4) =====
exitMode = input.string("Trailing runner", "Exit style", options=["Trailing runner","Fixed R target"], group="Exit",
     tooltip="Trailing runner = let winners run (the v4 fix). Fixed R target = old v3 behavior (caps winners at rMult).")
trailActR = input.float(1.0, "Trailing: arm after (R in profit)", group="Exit", minval=0.1,
     tooltip="Start trailing once the trade is this many R in profit. 1.0 = arm at +1R (locks ~breakeven), then follow.")
trailOffR = input.float(1.0, "Trailing: trail distance (R)", group="Exit", minval=0.1,
     tooltip="How far behind price the trailing stop sits, in R. Tighter = locks more but exits sooner; looser = rides bigger runs.")
rMult     = input.float(1.5, "Fixed target R (Fixed-R mode only)", group="Exit", minval=0.5)

// ===== Risk (stop placement) =====
stopMode = input.string("Opposite side", "Initial stop placement", options=["Opposite side","Midpoint","ATR"], group="Risk",
     tooltip="Opposite side = best in testing. Midpoint tested WORSE (gets chopped out). ATR = volatility-based.")
atrLen   = input.int(14, "ATR Length (ATR stop mode)", group="Risk")
atrMult  = input.float(1.5, "Stop = x ATR (ATR stop mode)", group="Risk")

// ===== Daily lockouts (OPT-IN — live only) =====
useDailyLockout = input.bool(false, "Enforce daily profit/loss lockout", group="Daily Lockout",
     tooltip="OFF for backtests/validation (absolute-$ rules distort NQ-vs-MNQ). ON only for LIVE trading on your exact contract size.")
profitTarget = input.float(1500, "Daily PROFIT target ($) - bank & stop", group="Daily Lockout")
dayLoss      = input.float(700,  "Daily LOSS limit ($) - hard stop", group="Daily Lockout")

// ===== Circuit breakers =====
maxTrades = input.int(2, "Max trades per day", group="Circuit breakers", minval=1,
     tooltip="2 = first break + ONE re-entry. 1 = no re-entry, 3 = aggressive.")

// ===== Direction / session =====
useLong  = input.bool(true, "Allow long breakouts",  group="Direction")
useShort = input.bool(true, "Allow short breakouts", group="Direction")
sess     = input.session("0930-1600", "RTH session (ET)", group="Filters")
flattenEOD = input.bool(true, "Flatten at session end", group="Filters")

// Free-plan window backtester:
useDateFilter = input.bool(false, "Limit to date window below", group="Backtest Window")
startDate     = input.time(timestamp("2026-01-01T00:00"), "Window start", group="Backtest Window")
endDate       = input.time(timestamp("2026-06-18T23:59"), "Window end",   group="Backtest Window")

// ===== Time helpers (ET) =====
etH    = hour(time, "America/New_York")
etM    = minute(time, "America/New_York")
etMins = etH * 60 + etM
openMins  = (openHHMM / 100) * 60 + (openHHMM % 100)
orEndMins = openMins + orMinutes
entryEnd  = (entryEndHHMM / 100) * 60 + (entryEndHHMM % 100)

inSession = not na(time(timeframe.period, sess, "America/New_York"))
inWindow  = not useDateFilter or (time >= startDate and time <= endDate)
tick      = syminfo.mintick
buf       = bufTicks * tick

vwap = ta.vwap(hlc3)

// ===== Per-day state =====
newDay = ta.change(time("D")) != 0
var float orHigh = na
var float orLow  = na
var bool  orDone = false
var int   tradesToday = 0
var float dayStartEq  = na
var float eStop = na
var float eTgt  = na
var float eActT = na   // trailing activation, in ticks
var float eOffT = na   // trailing offset, in ticks

if newDay
    orHigh := na
    orLow  := na
    orDone := false
    tradesToday := 0
    dayStartEq  := strategy.equity

inOR = etMins >= openMins and etMins < orEndMins
if inOR
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow, low)
if etMins >= orEndMins and not orDone and not na(orHigh)
    orDone := true

orRange = (na(orHigh) or na(orLow)) ? na : orHigh - orLow
rangeOK = not useRangeFilter or (not na(orRange) and orRange >= minRangePts and orRange <= maxRangePts)

// ===== Daily lockouts (opt-in) =====
dayPnL      = na(dayStartEq) ? 0.0 : strategy.equity - dayStartEq
lossLockout = useDailyLockout and dayPnL <= -dayLoss
targetHit   = useDailyLockout and dayPnL >= profitTarget
dayDone     = lossLockout or targetHit

atr = ta.atr(atrLen)

// ===== Breakout signals =====
inEntryWindow = etMins >= orEndMins and etMins < entryEnd
armed = orDone and rangeOK and inEntryWindow and tradesToday < maxTrades and strategy.position_size == 0 and not dayDone and inWindow

trendUpOK   = not useTrendFilter or close > vwap
trendDownOK = not useTrendFilter or close < vwap

longBreak  = armed and useLong  and not na(orHigh) and close > orHigh + buf and trendUpOK
shortBreak = armed and useShort and not na(orLow)  and close < orLow  - buf and trendDownOK

longStop  = stopMode == "Opposite side" ? orLow  : stopMode == "Midpoint" ? (orHigh + orLow) / 2 : close - atrMult * atr
shortStop = stopMode == "Opposite side" ? orHigh : stopMode == "Midpoint" ? (orHigh + orLow) / 2 : close + atrMult * atr
longRisk  = close - longStop
shortRisk = shortStop - close

// ===== Orders =====
if longBreak and longRisk > 0
    eStop := longStop
    eTgt  := close + rMult * longRisk
    eActT := math.max(1, math.round(longRisk * trailActR / tick))
    eOffT := math.max(1, math.round(longRisk * trailOffR / tick))
    strategy.entry("Long", strategy.long)
    tradesToday += 1
if shortBreak and shortRisk > 0
    eStop := shortStop
    eTgt  := close - rMult * shortRisk
    eActT := math.max(1, math.round(shortRisk * trailActR / tick))
    eOffT := math.max(1, math.round(shortRisk * trailOffR / tick))
    strategy.entry("Short", strategy.short)
    tradesToday += 1

inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0
if inLong
    if exitMode == "Fixed R target"
        strategy.exit("Exit Long", from_entry="Long", stop=eStop, limit=eTgt)
    else
        strategy.exit("Exit Long", from_entry="Long", stop=eStop, trail_points=eActT, trail_offset=eOffT)
if inShort
    if exitMode == "Fixed R target"
        strategy.exit("Exit Short", from_entry="Short", stop=eStop, limit=eTgt)
    else
        strategy.exit("Exit Short", from_entry="Short", stop=eStop, trail_points=eActT, trail_offset=eOffT)

// Flatten on EOD and (if enabled) on daily lockouts
sessionEnding = inSession[1] and not inSession
if flattenEOD and sessionEnding and strategy.position_size != 0
    strategy.close_all("EOD")
if lossLockout and strategy.position_size != 0
    strategy.close_all("Daily stop")
if targetHit and strategy.position_size != 0
    strategy.close_all("Target hit")

// ===== Status string =====
status = targetHit ? "TARGET HIT - banked, done" :
     lossLockout ? "LOSS STOP - done" :
     inLong ? "LONG (riding break)" :
     inShort ? "SHORT (riding break)" :
     inOR ? "OR building..." :
     (orDone and not rangeOK) ? "skip - OR size out of bounds" :
     armed ? "ARMED - waiting for break" :
     (etMins >= entryEnd and tradesToday == 0) ? "no break (window done)" :
     not inSession ? "closed" : "WAIT"

// ===== Visuals =====
showOR = (inOR or orDone) and inSession
plot(showOR and not na(orHigh) ? orHigh : na, "OR High", color=color.new(color.teal, 0), style=plot.style_linebr, linewidth=2)
plot(showOR and not na(orLow)  ? orLow  : na, "OR Low",  color=color.new(color.maroon, 0), style=plot.style_linebr, linewidth=2)
plot(inSession ? vwap : na, "VWAP", color=color.new(color.orange, 0), style=plot.style_linebr, linewidth=1)

longOpened  = strategy.position_size > 0 and strategy.position_size[1] <= 0
shortOpened = strategy.position_size < 0 and strategy.position_size[1] >= 0
justFlat    = strategy.position_size == 0 and strategy.position_size[1] != 0

if longOpened
    label.new(bar_index, low,  "BREAK+", style=label.style_label_up,   color=color.new(color.green,0), textcolor=color.white, size=size.small)
if shortOpened
    label.new(bar_index, high, "BREAK-", style=label.style_label_down, color=color.new(color.red,0),   textcolor=color.white, size=size.small)
if justFlat and strategy.closedtrades > 0
    i    = strategy.closedtrades - 1
    ePx  = strategy.closedtrades.entry_price(i)
    xPx  = strategy.closedtrades.exit_price(i)
    eBar = strategy.closedtrades.entry_bar_index(i)
    xBar = strategy.closedtrades.exit_bar_index(i)
    won  = strategy.closedtrades.profit(i) > 0
    col  = won ? color.new(color.green, 0) : color.new(color.red, 0)
    line.new(eBar, ePx, xBar, xPx, color=col, width=2)
    label.new(xBar, xPx, won ? "WIN" : "LOSS",
         style = won ? label.style_label_down : label.style_label_up,
         color=col, textcolor=color.white, size=size.tiny)

// ===== UI panel =====
var table t = table.new(position.top_right, 2, 9, border_width=1, frame_color=color.gray, frame_width=1)
if barstate.islast
    g = color.new(color.gray, 40)
    statusColor = targetHit ? color.green : lossLockout ? color.red : inLong ? color.green : inShort ? color.red : armed ? color.new(color.teal, 20) : color.new(color.gray, 30)
    pnlColor = targetHit ? color.green : lossLockout ? color.red : g
    table.cell(t, 0, 0, "ORB", bgcolor=color.black, text_color=color.white)
    table.cell(t, 1, 0, "v4",  bgcolor=color.black, text_color=color.white)
    table.cell(t, 0, 1, "Status", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 1, status,   text_color=color.white, bgcolor=statusColor)
    table.cell(t, 0, 2, "Exit", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 2, exitMode, text_color=color.white, bgcolor=g)
    table.cell(t, 0, 3, "OR High", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 3, na(orHigh) ? "-" : str.tostring(orHigh, "#.00"), text_color=color.white, bgcolor=g)
    table.cell(t, 0, 4, "OR Low", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 4, na(orLow) ? "-" : str.tostring(orLow, "#.00"), text_color=color.white, bgcolor=g)
    table.cell(t, 0, 5, "OR width", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 5, na(orRange) ? "-" : str.tostring(orRange, "#.0") + " pt", text_color=color.white, bgcolor=rangeOK ? g : color.new(color.orange, 20))
    table.cell(t, 0, 6, "VWAP", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 6, na(vwap) ? "-" : str.tostring(vwap, "#.00"), text_color=color.white, bgcolor=g)
    table.cell(t, 0, 7, "Day P/L", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 7, "$" + str.tostring(dayPnL, "#"), text_color=color.white, bgcolor=pnlColor)
    table.cell(t, 0, 8, "Trades today", text_color=color.white, bgcolor=g)
    table.cell(t, 1, 8, str.tostring(tradesToday) + " / " + str.tostring(maxTrades), text_color=color.white, bgcolor=g)

// ===== Alerts =====
alertcondition(longBreak,  "ORB LONG",  "ORB v4 BUY - broke ABOVE the opening range, with VWAP")
alertcondition(shortBreak, "ORB SHORT", "ORB v4 SELL - broke BELOW the opening range, with VWAP")
